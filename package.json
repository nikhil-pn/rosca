{
  "name": "rosca",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Rosca: the savings circle the organiser cannot run away with, on QoreChain.",
  "scripts": {
    "forge-std": "forge install foundry-rs/forge-std --no-git",
    "build": "forge build",
    "test": "forge test",
    "window": "tsx --env-file=.env scripts/window.ts",
    "deploy:testnet": "forge script script/Deploy.s.sol --rpc-url qorechain_testnet --broadcast",
    "typecheck": "tsc --noEmit",
    "rosca": "tsx scripts/rosca.ts",
    "build:app": "bash scripts/build-app.sh"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/sdk": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "create-qorechain-dapp": "^0.14.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "viem": "^2.0.0"
  }
}
